# Copy this file to .env and fill in real values. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here

# --- AWS Bedrock (optional) ---
# Both providers below authenticate with a Bedrock API key (bearer token) --
# generate one in the Bedrock console under "API keys", or with
# `aws bedrock create-api-key` on the CLI. Paste it into
# AWS_BEARER_TOKEN_BEDROCK; no AWS access key pair or IAM role needed.
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
AWS_REGION=us-east-1
# LLM_PROVIDER=bedrock routes Claude through Bedrock's native Messages route.
# Default model is a cross-region inference profile ID -- change the "us."
# region prefix, or drop it for a bare on-demand ID, if your account needs a
# different exact string (check `aws bedrock list-foundation-models` or the
# Bedrock console).
# LLM_PROVIDER=bedrock
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# LLM_PROVIDER=bedrock_openai calls gpt-oss-120b -- the same model this
# project's Groq default already serves -- through Bedrock's OpenAI-compatible
# endpoint instead: same behavior/quality, AWS billing, no Groq free-tier
# rate limit.
# LLM_PROVIDER=bedrock_openai
BEDROCK_OPENAI_MODEL=openai.gpt-oss-120b-1:0

# --- Fireworks AI (optional) ---
# Same gpt-oss-120b model as the Groq default and the two Bedrock providers
# above, hosted by Fireworks instead -- useful while Bedrock model access is
# still pending, since you already have Fireworks credit. Get a key at
# https://fireworks.ai/account/api-keys.
LLM_PROVIDER=fireworks
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b

# --- Cerebras (optional) ---
# Same gpt-oss-120b model again, hosted on Cerebras's wafer-scale inference
# hardware -- very fast. New accounts get a $5 trial credit (expires 30 days
# after signup; a verified payment method is required to activate it as of
# 2026). Get a key at https://cloud.cerebras.ai (API Keys page).
# LLM_PROVIDER=cerebras
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=gpt-oss-120b

# --- Embedding model (retrieval, independent of LLM_PROVIDER above) ---
# "normal" (default) = BAAI/bge-small-en-v1.5. Alternatives: "finlang"
# (FinLang/finance-embeddings-investopedia, already cached locally) or
# "financesmall" (baconnier/Finance_embedding_small_en-V1.5). Switching
# builds a new FAISS index per filing on first use under
# data/indexes/<doc_name>/<model>/ -- existing indexes for other models are
# left alone, so this is safe to flip back and forth.
EMBEDDING_MODEL=normal

# finlang and financesmall are both gated HF repos -- already downloaded and
# cached locally, but huggingface_hub still does an online freshness check
# before serving from cache, which needs HF auth and can 401 even though the
# files are fine (that's the "Cannot access gated repo" error). Forcing
# offline mode skips that check entirely and trusts the local cache.
# Comment this out (or delete it) the first time you switch to a model that
# ISN'T downloaded yet, or the download itself will fail outright.
HF_HUB_OFFLINE=1
