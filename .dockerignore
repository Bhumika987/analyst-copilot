.git
.gitignore
.claude
.pytest_cache
env/
__pycache__/
*.pyc
*.pyo

# User data -- created at runtime on a persistent volume, not shipped in
# the image (also keeps the build context small and the image reproducible
# regardless of what's been indexed locally).
data/uploads/
data/indexes/

# Secrets -- never bake API keys into the image. Set these as env vars /
# secrets in the host's dashboard instead (see DEPLOYMENT.md).
.env
.env.*

# Local-only artifacts
logs/
eval_results*.json
*.log
tests/
